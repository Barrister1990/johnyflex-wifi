# Copy to .env.local and fill in secrets for production.
# WiFiHub is a single-company deployment (one operator account).

APP_URL=http://localhost:3000

# --- Supabase (required) ---
# Create the operator in Supabase Auth (email/password), then sign in at /login.
# Run migrations 001 → 003 in the SQL editor (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase projects:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — portal writes, webhooks, and server repositories
SUPABASE_SERVICE_ROLE_KEY=

# Optional — receipt emails via Resend (otherwise portal print only)
RESEND_API_KEY=
EMAIL_FROM=WiFiHub <receipts@yourdomain.com>

# Required for scheduled expiry — must match Supabase secret WIFIHUB_CRON_SECRET
# Used by Edge Function expire-sessions (pg_cron every 5 min → this API)
CRON_SECRET=

# Optional — encrypt MikroTik passwords at rest (falls back to service role key)
ROUTER_PASSWORD_SECRET=

# mock (default) | paystack
# Local Paystack: see PAYSTACK_LOCAL_SETUP.md
# Webhook URL = {APP_URL}/api/payments/webhook
# PAYSTACK_WEBHOOK_SECRET is usually the same as PAYSTACK_SECRET_KEY
PAYMENT_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional — fills the MikroTik wizard "copy script" (set once on the VPS)
WIREGUARD_VPS_PUBLIC_IP=
WIREGUARD_VPS_PUBLIC_KEY=
# MikroTik peer private key (from ~/mt-private.key on the VPS) — one-paste wizard
WIREGUARD_PEER_PRIVATE_KEY=
WIREGUARD_SERVER_ADDRESS=10.8.0.1
WIREGUARD_PEER_ADDRESS=10.8.0.2
WIREGUARD_LISTEN_PORT=51820

# mock (default) | mikrotik
# Live unlock uses credentials saved in the MikroTik wizard (preferred).
# ROUTER_ADAPTER=mikrotik forces MikroTik adapter for the dashboard telemetry.
# Env MIKROTIK_* below is an optional single-site fallback only.
ROUTER_ADAPTER=mock
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=
# REST port: 80 (http) or 443 (https). Set MIKROTIK_SECURE=1 for https.
MIKROTIK_PORT=80
MIKROTIK_SECURE=0
